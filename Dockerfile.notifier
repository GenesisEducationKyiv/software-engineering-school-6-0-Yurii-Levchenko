# Build + run the notifier microservice (cmd/notifier). Mirrors the monolith's
# Dockerfile but compiles the notifier binary and ships no migrations/static.
# Stage 1: Build
FROM golang:1.24-alpine AS builder

ENV GOTOOLCHAIN=auto

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -o /app/notifier ./cmd/notifier

# Stage 2: Run
FROM alpine:3.19

WORKDIR /app

COPY --from=builder /app/notifier .

EXPOSE 9090

CMD ["./notifier"]
